[Unit]
Description=VISTA R8 deterministic native builder (phase A)
ConditionPathExists=/etc/vista-r8-native-builder-r1/source.bundle
ConditionPathExists=/etc/vista-r8-native-builder-r1/phase-a-request.json
ConditionPathExists=!/var/lib/vista-r8-native-builder-r1/phase-a-slot/published/manifest.json

[Service]
Type=oneshot
User=vista-r8-builder
Group=vista-r8-builder
SupplementaryGroups=
UMask=0077
WorkingDirectory=/var/lib/vista-r8-native-builder-r1/phase-a-slot
ExecStart=/usr/bin/python3.10 -I -B /usr/local/libexec/vista-r8-native-builder-r1/vista_r8_native_builder.py --phase phase-a
Restart=no
KillMode=control-group
KeyringMode=private
StandardInput=null
StandardOutput=journal
StandardError=journal
Environment=HOME=/nonexistent
Environment=PATH=/usr/bin:/bin
Environment=LANG=C
Environment=LC_ALL=C
Environment=PYTHONHASHSEED=0
Environment=SOURCE_DATE_EPOCH=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
ReadOnlyPaths=/etc/vista-r8-native-builder-r1
ReadOnlyPaths=/usr/local/libexec/vista-r8-native-builder-r1
ReadWritePaths=/var/lib/vista-r8-native-builder-r1/phase-a-slot
InaccessiblePaths=/root /home /media /mnt /srv /run/user
DevicePolicy=closed
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=ptrace
SystemCallFilter=~@clock @module @mount @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
TasksMax=64
LimitNPROC=64
TimeoutStartSec=30min
TimeoutStopSec=30s
