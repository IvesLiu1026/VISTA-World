{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IvesLiu1026/VISTA-World/world_packs/schemas/vista-playable-animation-profile-v1.schema.json",
  "title": "VISTA Playable Animation Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_revision",
    "engine",
    "provenance",
    "source_assets",
    "authored_assets",
    "actions",
    "acceptance_gates",
    "current_readiness",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "vista.playable-animation-profile/v1"},
    "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "profile_revision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,95}$"},
    "engine": {"$ref": "#/$defs/engine"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "source_assets": {
      "type": "array",
      "minItems": 10,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/sourceAsset"}
    },
    "authored_assets": {
      "type": "array",
      "minItems": 15,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/authoredAsset"}
    },
    "actions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/action"}
    },
    "acceptance_gates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/gate"}
    },
    "current_readiness": {"$ref": "#/$defs/readiness"},
    "content_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "platform", "project_owned_root"],
      "properties": {
        "name": {"const": "Unreal Engine"},
        "version": {"const": "5.7.3"},
        "platform": {"const": "Linux"},
        "project_owned_root": {"const": "/Game/VISTA/Animations/V1"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_dataset_revision",
        "source_archive_name",
        "source_archive_sha256",
        "source_archive_size_bytes",
        "source_project_name",
        "source_project_patch",
        "source_engine_version",
        "raw_payload_policy",
        "legacy_profile_is_current_evidence"
      ],
      "properties": {
        "source_repository": {"const": "SimWorld-AI/SimWorld-Studio"},
        "source_dataset_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_archive_name": {"const": "SimWorld-Studio-Minimal.tar.gz"},
        "source_archive_sha256": {"$ref": "#/$defs/sha256"},
        "source_archive_size_bytes": {"type": "integer", "minimum": 1},
        "source_project_name": {"const": "gym_citynav"},
        "source_project_patch": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_engine_version": {"const": "5.3.2"},
        "raw_payload_policy": {"const": "external_only_never_git"},
        "legacy_profile_is_current_evidence": {"const": false}
      }
    },
    "sourceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_asset_id",
        "semantic_role",
        "source_object_path",
        "expected_class",
        "source_file_sha256",
        "source_size_bytes",
        "source_engine_version",
        "license_id",
        "license_status",
        "inventory_state"
      ],
      "properties": {
        "source_asset_id": {"$ref": "#/$defs/identifier"},
        "semantic_role": {"$ref": "#/$defs/identifier"},
        "source_object_path": {
          "type": "string",
          "pattern": "^/Game/[A-Za-z0-9_/]+\\.[A-Za-z0-9_]+(?:_C)?$"
        },
        "expected_class": {
          "type": "string",
          "pattern": "^/Script/[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$"
        },
        "source_file_sha256": {"$ref": "#/$defs/sha256"},
        "source_size_bytes": {"type": "integer", "minimum": 1},
        "source_engine_version": {"const": "5.3.2"},
        "license_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.-]{2,63}$"},
        "license_status": {
          "enum": ["verified_for_unreal_project", "review_required"]
        },
        "inventory_state": {"const": "filename_digest_verified"}
      }
    },
    "authoredAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "role",
        "object_path",
        "expected_class",
        "source_asset_ids",
        "authoring_recipe",
        "authoring_state",
        "required_live_checks"
      ],
      "properties": {
        "asset_id": {"$ref": "#/$defs/identifier"},
        "role": {"$ref": "#/$defs/identifier"},
        "object_path": {
          "type": "string",
          "pattern": "^/Game/VISTA/Animations/V1/[A-Za-z0-9_/]+\\.[A-Za-z0-9_]+(?:_C)?$"
        },
        "expected_class": {
          "type": "string",
          "pattern": "^/Script/[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$"
        },
        "source_asset_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "authoring_recipe": {
          "enum": [
            "duplicate_and_rebind",
            "author_blueprint",
            "author_control_rig",
            "author_ik_rig",
            "author_montage"
          ]
        },
        "authoring_state": {
          "enum": [
            "recipe_ready",
            "blocked_on_source",
            "blocked_on_license",
            "blocked_on_semantic_match"
          ]
        },
        "required_live_checks": {"$ref": "#/$defs/checkList"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "phase",
        "implementation_asset_id",
        "target_policy",
        "root_motion_policy",
        "required_notifies",
        "required_live_checks",
        "timeout_ms",
        "readiness"
      ],
      "properties": {
        "action_id": {"$ref": "#/$defs/identifier"},
        "phase": {"enum": ["t12", "t13"]},
        "implementation_asset_id": {"$ref": "#/$defs/identifier"},
        "target_policy": {"enum": ["required", "optional", "forbidden"]},
        "root_motion_policy": {"enum": ["required", "forbidden", "not_applicable"]},
        "required_notifies": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^vista_[a-z0-9_]{3,63}$"}
        },
        "required_live_checks": {"$ref": "#/$defs/checkList"},
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 60000},
        "readiness": {
          "enum": [
            "source_ready",
            "blocked_on_source",
            "blocked_on_license",
            "blocked_on_semantic_match"
          ]
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "evidence_kind", "required_checks", "state"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/identifier"},
        "evidence_kind": {"$ref": "#/$defs/identifier"},
        "required_checks": {"$ref": "#/$defs/checkList"},
        "state": {"enum": ["pending", "passed"]}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "accepted", "passed_gate_ids", "blocking_gate_ids"],
      "properties": {
        "state": {"const": "source_inventory_only"},
        "accepted": {"const": false},
        "passed_gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "blocking_gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  }
}
