{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simworld.org/schemas/vista-playable-action-catalog-v5.schema.json",
  "title": "VISTA Playable Indoor Action Catalog v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_revision",
    "source_catalog_binding",
    "candidate_animation_sources",
    "actions",
    "accepted",
    "runtime_execution_authorized",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "vista.playable-action-catalog/v5"},
    "catalog_id": {"const": "vista_indoor_actions"},
    "catalog_revision": {"const": "vista_indoor_actions_r5"},
    "source_catalog_binding": {"$ref": "#/$defs/sourceCatalogBinding"},
    "candidate_animation_sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/candidateAnimationSource"}
    },
    "actions": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {"$ref": "#/$defs/actionRecord"}
    },
    "accepted": {"const": false},
    "runtime_execution_authorized": {"const": false},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$",
      "maxLength": 96
    },
    "sourceCatalogBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "catalog_id", "catalog_revision", "content_digest"],
      "properties": {
        "schema_version": {"const": "vista.playable-action-catalog/v4"},
        "catalog_id": {"const": "vista_indoor_actions"},
        "catalog_revision": {"const": "vista_indoor_actions_r4"},
        "content_digest": {"const": "0865991e4ee97da51c62a593f3cce34275316b3b025c994cb66fbb245b342107"}
      }
    },
    "candidateAnimationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "profile_schema_version",
        "profile_id",
        "content_digest",
        "acceptance_state",
        "action_ids"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "profile_schema_version": {
          "type": "string",
          "pattern": "^vista\\.[a-z0-9-]+/v[0-9]+$",
          "maxLength": 96
        },
        "profile_id": {"$ref": "#/$defs/identifier"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "acceptance_state": {"const": "candidate_unaccepted"},
        "action_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "readinessLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_digest"],
      "properties": {
        "status": {"enum": ["verified", "candidate", "blocked", "not_applicable"]},
        "evidence_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        }
      }
    },
    "layeredReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "animation", "object_state", "event_mapping", "runtime_acceptance"],
      "properties": {
        "backend": {"$ref": "#/$defs/readinessLayer"},
        "animation": {"$ref": "#/$defs/readinessLayer"},
        "object_state": {"$ref": "#/$defs/readinessLayer"},
        "event_mapping": {"$ref": "#/$defs/readinessLayer"},
        "runtime_acceptance": {"$ref": "#/$defs/readinessLayer"}
      }
    },
    "parameterName": {
      "enum": [
        "room_id",
        "target_id",
        "secondary_target_id",
        "placement_anchor_id",
        "duration_s",
        "distance_cm",
        "height_cm",
        "hand",
        "foot",
        "direction",
        "pose"
      ]
    },
    "parameterPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/parameterName"}
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/parameterName"}
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "commit_phase"],
      "properties": {
        "effect_id": {
          "enum": [
            "none",
            "actor_pose",
            "actor_motion",
            "held_state_claim",
            "held_state_release",
            "target_state",
            "target_transform",
            "multi_entity_state"
          ]
        },
        "commit_phase": {"enum": ["none", "contact", "release", "completion"]}
      }
    },
    "targetRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "secondary_target_id"],
      "properties": {
        "target_id": {"const": "storage_item"},
        "secondary_target_id": {"const": "storage_container"}
      }
    },
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wire_action", "backend_action", "runtime_type"],
      "properties": {
        "wire_action": {"enum": ["insert", "remove"]},
        "backend_action": {"enum": ["Insert", "Remove"]},
        "runtime_type": {"enum": ["insert", "remove"]}
      }
    },
    "animationAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "montage_policy",
        "contact_signal",
        "completion_signal",
        "prohibited_reuse_action_ids"
      ],
      "properties": {
        "status": {"const": "blocked"},
        "montage_policy": {"const": "dedicated_action_montage_required"},
        "contact_signal": {"const": "required"},
        "completion_signal": {"const": "required"},
        "prohibited_reuse_action_ids": {
          "type": "array",
          "prefixItems": [
            {"const": "pick_up"},
            {"const": "place"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "nativeActionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "aliases",
        "target_policy",
        "secondary_target_policy",
        "target_roles",
        "approach_policy",
        "parameters",
        "effect",
        "rollback_policy",
        "dispatch_policy",
        "runtime_binding",
        "animation_acceptance"
      ],
      "properties": {
        "family": {"const": "storage_transaction"},
        "aliases": {"type": "array", "maxItems": 0},
        "target_policy": {"const": "required"},
        "secondary_target_policy": {"const": "required"},
        "target_roles": {"$ref": "#/$defs/targetRoles"},
        "approach_policy": {"const": "align_secondary_target"},
        "parameters": {"$ref": "#/$defs/parameterPolicy"},
        "effect": {"$ref": "#/$defs/effect"},
        "rollback_policy": {"const": "restore_actor_and_target"},
        "dispatch_policy": {"const": "direct"},
        "runtime_binding": {"$ref": "#/$defs/runtimeBinding"},
        "animation_acceptance": {"$ref": "#/$defs/animationAcceptance"}
      }
    },
    "actionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "source_action_id", "native_definition", "readiness"],
      "properties": {
        "action_id": {"$ref": "#/$defs/identifier"},
        "source_action_id": {
          "oneOf": [
            {"$ref": "#/$defs/identifier"},
            {"type": "null"}
          ]
        },
        "native_definition": {
          "oneOf": [
            {"$ref": "#/$defs/nativeActionDefinition"},
            {"type": "null"}
          ]
        },
        "readiness": {"$ref": "#/$defs/layeredReadiness"}
      }
    }
  }
}
