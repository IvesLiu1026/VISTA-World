{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IvesLiu1026/VISTA-World/world_packs/schemas/vista-playable-makehuman-cc0-animation-profile-v1.schema.json",
  "title": "VISTA MakeHuman CC0 Animation Vertical Slice Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "character_id",
    "rig_contract",
    "license_scope",
    "provenance",
    "clips",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "vista.makehuman-cc0-animation-profile/v1"},
    "profile_id": {"const": "makehuman_cc0_animation_vertical_slice_r1"},
    "character_id": {"const": "makehuman_cc0_eurasian_female_arkit_v3"},
    "rig_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armature_name", "root_bone", "bone_count", "coordinate_system"],
      "properties": {
        "armature_name": {"const": "VISTA_CC0_Hero_Rig_export"},
        "root_bone": {"const": "root"},
        "bone_count": {"const": 53},
        "coordinate_system": {"const": "blender_m_z_up_ue_export_minus_y_forward"}
      }
    },
    "license_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_source_spdx", "motion_recipe_spdx", "external_binary_policy"],
      "properties": {
        "character_source_spdx": {"const": "CC0-1.0"},
        "motion_recipe_spdx": {"const": "CC0-1.0"},
        "external_binary_policy": {"const": "outside_git_only"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion_origin",
        "contains_manny_derived_motion",
        "contains_metahuman_motion",
        "contains_city_sample_motion",
        "contains_simworld_motion",
        "contains_motion_capture"
      ],
      "properties": {
        "motion_origin": {"const": "project_authored_numeric_keyframes"},
        "contains_manny_derived_motion": {"const": false},
        "contains_metahuman_motion": {"const": false},
        "contains_city_sample_motion": {"const": false},
        "contains_simworld_motion": {"const": false},
        "contains_motion_capture": {"const": false}
      }
    },
    "clips": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/clip"}
    },
    "content_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "kind", "signal"],
      "properties": {
        "frame": {"type": "integer", "minimum": 0, "maximum": 600},
        "kind": {"enum": ["contact", "release", "completion"]},
        "signal": {"type": "string", "pattern": "^vista_[a-z0-9_]{3,63}$"}
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clip_id",
        "action_name",
        "ue_sequence_name",
        "ue_montage_name",
        "frame_start",
        "frame_end",
        "fps",
        "loop",
        "root_motion_policy",
        "target_height_cm",
        "typed_notifies",
        "recipe_id"
      ],
      "properties": {
        "clip_id": {"enum": ["idle", "walk", "run", "mug_pickup_countertop", "mug_place_countertop"]},
        "action_name": {"type": "string", "pattern": "^VISTA_CC0_[A-Za-z0-9_]{3,63}$"},
        "ue_sequence_name": {"type": "string", "pattern": "^AS_VistaCC0[A-Za-z0-9_]{2,63}$"},
        "ue_montage_name": {
          "oneOf": [
            {"type": "string", "pattern": "^AM_VistaCC0[A-Za-z0-9_]{2,63}$"},
            {"type": "null"}
          ]
        },
        "frame_start": {"const": 0},
        "frame_end": {"type": "integer", "minimum": 20, "maximum": 120},
        "fps": {"const": 30},
        "loop": {"type": "boolean"},
        "root_motion_policy": {"const": "forbidden"},
        "target_height_cm": {
          "oneOf": [
            {"type": "integer", "minimum": 40, "maximum": 150},
            {"type": "null"}
          ]
        },
        "typed_notifies": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/notify"}},
        "recipe_id": {"type": "string", "pattern": "^cc0_numeric_[a-z0-9_]{3,63}_r1$"}
      }
    }
  }
}
